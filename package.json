{
  "name": "discuva-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "hash:password": "ts-node scripts/hash-password.ts",
    "seed:admin": "ts-node -r dotenv/config -r tsconfig-paths/register src/seed.ts",
    "seed:admin:prod": "node dist/seed",
    "seed:platform-admin": "ts-node -r dotenv/config -r tsconfig-paths/register src/seed-platform-admin.ts",
    "seed:platform-admin:prod": "node dist/seed-platform-admin",
    "provision:tenant": "ts-node -r dotenv/config -r tsconfig-paths/register src/provision-tenant.ts",
    "provision:tenant:prod": "node dist/provision-tenant",
    "migration:run:all-tenants": "ts-node -r dotenv/config -r tsconfig-paths/register src/migrate-all-tenants.ts",
    "migration:run:all-tenants:prod": "node dist/migrate-all-tenants",
    "migration:generate": "ts-node -r dotenv/config -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:generate src/migrations/Migration -d src/data-source.ts",
    "migration:run": "ts-node -r dotenv/config -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:run -d src/data-source.ts",
    "migration:run:prod": "./node_modules/.bin/typeorm migration:run -d dist/data-source.js",
    "migration:revert": "ts-node -r dotenv/config -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:revert -d src/data-source.ts",
    "migration:revert:prod": "./node_modules/.bin/typeorm migration:revert -d dist/data-source.js",
    "migration:show": "ts-node -r dotenv/config -r tsconfig-paths/register ./node_modules/.bin/typeorm migration:show -d src/data-source.ts",
    "migration:show:prod": "./node_modules/.bin/typeorm migration:show -d dist/data-source.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@nestjs-cls/transactional": "^3.2.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^1.3.5",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.26",
    "@sentry/node": "^10.69.0",
    "@simplewebauthn/server": "^13.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/markdown-it": "^14.1.2",
    "@types/nodemailer": "^6.4.17",
    "argon2": "^0.41.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.9",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "jsdom": "^28.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "markdown-it": "^14.2.0",
    "marked": "^18.0.5",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "^4.3.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.3",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.16.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.21",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint --fix"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@exodus)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
