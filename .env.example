# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=3000                     # HTTP port the server listens on

CORS_ORIGINS=http://localhost:3000  # Comma-separated list of allowed origins

# Base domain TenantMiddleware strips off the request Host header to find a
# tenant's subdomain (e.g. APP_BASE_DOMAIN=discoveryhub.app means a request
# to church-beta.discoveryhub.app resolves tenant "church-beta"). Defaults
# to localhost in dev — *.localhost resolves to 127.0.0.1 with no /etc/hosts
# changes needed. Change once a real production domain is chosen.
APP_BASE_DOMAIN=localhost

# ─── Application branding (used in email templates and PDFs) ─────────────────
APP_NAME=discuva-api                # Identifies the app in PostgreSQL monitoring
PRODUCT_NAME=Discuva                # Product name shown in email subjects and the root page
CHURCH_NAME=RCCG Discovery Centre   # Church/org name in email templates and PDF headers
CHURCH_TAGLINE=Destinies discovered, Champions raised  # Tagline shown in PDF headers
CHURCH_ADDRESS=62 Igi Olugbin Street, Bariga. Lagos, Nigeria  # Address in PDF footers and emails
LOGO_URL=                           # URL to your church logo (used in email templates)
CURRENCY_CODE=NGN                   # ISO 4217 currency code (e.g. NGN, USD, GBP)
CURRENCY_LOCALE=en-NG               # Locale for number formatting (e.g. en-NG, en-US, en-GB)
TIMEZONE=Africa/Lagos               # IANA timezone for date/time display (e.g. Europe/London)
POSTMAN_URL=                        # Public Postman collection URL shown on the root page

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL=false            # Set to true to enable SSL with rejectUnauthorized=false
DATABASE_LOGGING=false        # Set to true to log SQL queries

# Connection pool (pg library)
DATABASE_POOL_SIZE=50         # Max connections in the pool (default: 50)
DATABASE_POOL_MIN=10          # Min idle connections kept alive (default: 10)
DATABASE_POOL=transaction     # Pool mode for PgBouncer/Supavisor: transaction | session | statement
DATABASE_POOL_LOG=false       # Log pool statistics (default: false)
DATABASE_DEBUG=false          # Enable query debug logging in development (default: false)

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY_IN=1h              # e.g. 1h, 15m, 7d

REFRESH_JWT_SECRET=
REFRESH_JWT_EXPIRY_IN=7d
SESSION_MAX_AGE_DAYS=30        # Absolute session lifetime in days — refresh is rejected after this regardless of rotation (default: 30)

# Deliberately separate from JWT_SECRET — platform-admin tokens (the
# discovery-hub-platform superadmin dashboard) must never validate against
# the same secret as tenant/member tokens.
PLATFORM_ADMIN_JWT_SECRET=
PLATFORM_ADMIN_JWT_EXPIRY_IN=1h

# Encrypts tenant BYOK SMS/email provider credentials at rest
# (tenant_communication_provider_configs.credentials_encrypted). Any string
# 32+ chars — hashed internally to a real AES-256 key, no fixed hex/base64
# format required. Rotating this makes every previously-encrypted
# credential unreadable — there is no re-encryption tooling yet.
CREDENTIALS_ENCRYPTION_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Which platform-default provider EmailQueueService dispatches through for a
# tenant with no BYOK email config of its own. gmail | resend (default: gmail)
EMAIL_PROVIDER=gmail
EMAIL_FROM=                   # From address for platform-default sends

# Gmail provider (platform default) — a tenant's own BYOK config may also
# override host/port/secure to route through Outlook/Office365/Zoho/their
# own mail server instead.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false            # true for port 465, false for 587
EMAIL_SERVICE=                # e.g. gmail (optional if HOST/PORT are set)
EMAIL_USER=
EMAIL_PASSWORD=

# Resend provider — only used when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SendGrid provider — platform default; tenants may override via BYOK
SENDGRID_API_KEY=
SENDGRID_BASE_URL=            # optional, defaults to https://api.sendgrid.com

# Mailgun provider — platform default; tenants may override via BYOK
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=             # optional, e.g. https://api.eu.mailgun.net/v3 for the EU region

# ─── Email notification toggles ───────────────────────────────────────────────
# Per-category kill switches — each defaults to true; set to false to mute
# that category platform-wide without touching the sending code itself.
EMAIL_ATTENDANCE_CHECKIN_ENABLED=true
EMAIL_BIRTHDAY_ENABLED=true
EMAIL_EVENT_REMINDER_ENABLED=true
EMAIL_PRAYER_REMINDER_ENABLED=true
EMAIL_FOLLOW_UP_ENABLED=true
EMAIL_ASSET_ALERTS_ENABLED=true
EMAIL_GIVING_RECEIPT_ENABLED=true
EMAIL_FINANCE_ALERTS_ENABLED=true
EMAIL_SESSION_REPORT_ENABLED=true
EMAIL_INCIDENT_REPORT_ENABLED=true
EMAIL_CHILDREN_CHURCH_ENABLED=true
EMAIL_LOGIN_ALERT_ENABLED=true
EMAIL_PASTOR_FEEDBACK_ENABLED=true
EMAIL_MEMBERSHIP_ANNIVERSARY_ENABLED=true

# ─── Web push (REQUIRED — app will not boot without these) ───────────────────
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                # mailto:you@yourdomain.com or a https:// URL

# ─── SMS ────────────────────────────────────────────────────────────────────
# BYOK only (Termii/Twilio) — every tenant sets its own credentials via
# PUT /v1/communication-providers. This is the one platform-wide, non-secret
# piece: the base URL Termii's own API lives at.
TERMII_BASE_URL=https://api.ng.termii.com

# ─── Bull Board (optional — /queues dashboard) ────────────────────────────────
# Mounted only when BOTH are set; Basic-Auth protected. Leave both blank to
# not expose the dashboard at all.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ─── Auth / OTP ──────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=900                   # How long a reset OTP stays valid (default: 900 = 15 min)
FORGOT_PASSWORD_MAX_ATTEMPTS=3        # Max OTP requests allowed per rate-limit window (default: 3)
FORGOT_PASSWORD_WINDOW_SECONDS=3600   # Rate-limit window for forgot-password (default: 3600 = 1 hr)
DEVICE_RESET_MAX_ATTEMPTS=3           # Max self-service device-reset OTP requests per window (default: 3)
DEVICE_RESET_WINDOW_SECONDS=86400     # Rate-limit window for device reset (default: 86400 = 24 hr)

# ─── Global rate limiting (applied to every endpoint via ThrottlerGuard) ─────
THROTTLE_TTL_MS=60000        # Sliding window in milliseconds (default: 60000 = 1 min)
THROTTLE_LIMIT=100            # Max requests per window per IP (default: 100)

# ─── Login rate limiting ──────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5                  # Max failed login attempts before lockout (default: 5)
LOGIN_WINDOW_SECONDS=900              # Lockout window duration in seconds (default: 900 = 15 min)

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost           # Redis server hostname
REDIS_PORT=6379               # Redis server port (default: 6379)
REDIS_PASSWORD=               # Redis password (leave blank if no auth)
REDIS_DB=0                    # Redis database index (default: 0)
REDIS_TLS=false                # true for managed Redis providers requiring TLS (e.g. Upstash)

# ─── Cache TTLs ──────────────────────────────────────────────────────────────
CACHE_TTL_REFERENCE_SECONDS=300       # TTL for infrequently-changing data: departments, venues, event configs (default: 300 = 5 min)
CACHE_TTL_LEADERBOARD_SECONDS=90      # TTL for attendance leaderboard (default: 90 s)

# ─── Birthday wishes ─────────────────────────────────────────────────────────
WISH_DAILY_LIMIT=20           # Max birthday wishes a single user can send per day (default: 20)

# ─── Attendance / check-in ───────────────────────────────────────────────────
ENFORCE_DISTANCE_CHECK=false  # Require workers to be within allowedDistanceInMeters to check in
ONLINE_CHECKIN_WINDOW_HOURS=3            # How many hours around a service an online check-in is accepted (default: 3)
SERVICE_SLOT_CAUTION_THRESHOLD_RATIO=0.25 # Fraction-filled at which a volunteer slot shows a "filling up" warning (default: 0.25)

# ─── Follow-up ───────────────────────────────────────────────────────────────
FOLLOW_UP_DUE_DAYS=3           # Days after assignment before a follow-up task is "due" (default: 3)
FOLLOW_UP_STALE_DAYS=7         # Days overdue before a follow-up task is flagged "stale" (default: 7)

# ─── Incident reports ─────────────────────────────────────────────────────────
INCIDENT_DAILY_REPORT_LIMIT=2  # Max incident reports a single member can file per day (default: 2)

# ─── Giving statements ─────────────────────────────────────────────────────────
ANNUAL_GIVING_STATEMENT_ENABLED=false  # Generate and email year-end giving statements each January

# ─── Admin seed ───────────────────────────────────────────────────────────────
# Run once at deploy time: npm run seed:admin (or node dist/seed in prod)
# Generate the hash locally: npm run hash:password
# After first successful seed, unset both vars from your PaaS / CI config.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD_HASH=

# ─── Platform admin seed ──────────────────────────────────────────────────────
# Same shape as the admin seed above, but for the very first platform admin
# (control-plane, /platform/* routes) — run once: npm run seed:platform-admin
# (or node dist/seed-platform-admin in prod). Same hash-generation command
# (npm run hash:password — already generic, no platform-specific variant
# needed). Seeds them with the SuperAdmin platform role (all permissions).
# After first successful seed, unset both vars from your PaaS / CI config.
DEFAULT_PLATFORM_ADMIN_EMAIL=
DEFAULT_PLATFORM_ADMIN_PASSWORD_HASH=

# ─── App URLs (embedded in emails) ───────────────────────────────────────────
# Bare, tenant-less base URLs — one build/config serves every tenant via
# wildcard subdomain, so EmailQueueService rewrites the host to carry the
# current tenant's subdomain (e.g. LOGIN_URL=https://discuva.org/login
# becomes https://church-alpha.discuva.org/login) before either ever
# reaches a template. Never reference these directly for a tenant-facing
# link — use the auto-injected {{login_url}}/{{admin_login_url}} template
# variables instead (or UtilityService.resolveTenantLoginUrl() outside a
# template).
LOGIN_URL=
ADMIN_LOGIN_URL=
# discovery-hub-platform's own base URL — used to build the
# /set-password?email=...&otp=... link a newly-onboarded platform admin
# gets emailed (mirrors ADMIN_LOGIN_URL's role for tenant admins).
# Deliberately NOT tenant-scoped — platform admins aren't tied to any tenant.
PLATFORM_LOGIN_URL=
SUPPORT_FORM_URL=
EXPLAINER_VIDEO_ANDROID_URL=
EXPLAINER_VIDEO_IOS_URL=

# ─── Cloudinary (file uploads for finance attachments / proofs) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Error tracking (Sentry) ───────────────────────────────────────────────────
# Optional — leave SENTRY_DSN blank to disable entirely (default for local dev).
# SENTRY_ENABLED is a separate kill switch on top of that: set to false to mute
# reporting without removing the DSN. Only 5xx and unhandled exceptions are
# reported (see HttpExceptionFilter) — routine 4xx responses are not.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=

# ─── File upload limits ────────────────────────────────────────────────────────
# Global default (also the Multer module-wide fallback) and the limit used by
# routes with no more specific category below — incident report photos,
# member bulk-import spreadsheets. Defaults to 5 MB.
MAX_FILE_UPLOAD_BYTES=5242880

# Training class study material uploads (PDFs, docs) — separate from the
# default above since course material tends to run larger than
# images/proofs. Defaults to 10 MB.
MAX_CLASS_MATERIAL_UPLOAD_BYTES=10485760

# Small-image convention shared by every logo/photo/avatar upload route —
# tenant logo, tenant custom asset images, member profile photo. Defaults to 3 MB.
MAX_AVATAR_UPLOAD_BYTES=3145728

# Finance request payment-proof attachments — its own var rather than reusing
# MAX_CLASS_MATERIAL_UPLOAD_BYTES (same 10 MB value today, but semantically
# unrelated). Defaults to 10 MB.
MAX_FINANCE_PROOF_UPLOAD_BYTES=10485760

# How many days before an uploaded tithe payment proof is purged from Cloudinary
# and deleted from the database. Defaults to 90 if not set.
TITHE_PROOF_EXPIRY_DAYS=90

# ─── Asset management ─────────────────────────────────────────────────────────
# Comma-separated list of days-overdue thresholds at which a reminder is sent
# to the checkout recipient. Leave empty to disable overdue notifications.
# Default: 1,3,7 (reminder on day 1, day 3, and day 7 after the expected return date)
ASSET_OVERDUE_NOTIFICATION_DAYS=1,3,7

# ─── YouTube live-detection (optional, platform-wide) ─────────────────────────
# Channel id and (optionally) a Data API key are set per tenant via
# PUT /v1/youtube-integration — never here. These two are the only
# platform-wide pieces, both optional — leave unset to skip WebSub entirely
# and use the Sermon Archive's manual "Announce Live" button instead. They're
# required together: without YOUTUBE_WEBSUB_SECRET, subscribe() never
# registers a live subscription and the callback rejects every notification.
# YOUTUBE_API_KEY is a fallback only — used for a tenant that configured a
# channel but not their own key.
YOUTUBE_API_KEY=
YOUTUBE_WEBSUB_CALLBACK_URL=
YOUTUBE_WEBSUB_SECRET=
PUBSUBHUBBUB_URL=             # optional, defaults to https://pubsubhubbub.appspot.com/subscribe

# ─── Billing: Paystack / Flutterwave (optional, platform-wide) ────────────────
# Both providers, both optional, both platform-wide — there is no per-tenant
# BYOK here (unlike SMS/email/YouTube): Paystack/Flutterwave keys are the
# PLATFORM's own merchant credentials, since these charges pay the platform
# (plan upgrades), not a tenant's own vendor account.
# A checkout call picks a provider by name, defaulting to
# DEFAULT_PAYMENT_PROVIDER when unspecified; a provider whose secret key
# isn't set here simply can't be selected (clean 400, not a crash).
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
# Shared secret you configure in the Flutterwave dashboard's webhook
# settings — compared verbatim against the verif-hash header, not an HMAC key.
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
DEFAULT_PAYMENT_PROVIDER=paystack

# Billing-cycle policy — how long a paid period lasts per successful charge,
# and how long a lapsed (PAST_DUE) subscription keeps its features before
# being downgraded to Free.
SUBSCRIPTION_PERIOD_DAYS=30
GRACE_PERIOD_DAYS=7
